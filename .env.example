# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bookstore

# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000

# MongoDB Connection
# Get your connection string from MongoDB Atlas:
# 1. Log into https://cloud.mongodb.com/
# 2. Go to your cluster -> Connect -> Connect your application
# 3. Copy the connection string and replace with your values
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/your_database?retryWrites=true&w=majority&appName=YourAppName

# JWT Secret Key (use a secure random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Example connection string format:
# MONGO_URI=mongodb+srv://hoangphatpy123:Phat12345@cluster0.ybivzfj.mongodb.net/bookstore?retryWrites=true&w=majority&appName=Cluster0

# Note: Never commit the actual .env file with real credentials to git
# This is just a template to show what environment variables are needed
