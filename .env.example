# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bookstore

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Note: Never commit the actual .env file with real credentials to git
# This is just a template to show what environment variables are needed
